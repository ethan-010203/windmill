COMPOSE_PROJECT_NAME=internal-windmill

# Local host ports. APP_PORT is the browser port for this internal system.
APP_PORT=8000
POSTGRES_PORT=5432

# Database. Change POSTGRES_PASSWORD before production use.
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgres://postgres:change-this-postgres-password@postgres:5432/windmill

# Local access URL. Keep BASE_URL and WM_BASE_URL aligned.
BASE_URL=http://127.0.0.1:8000
WM_BASE_URL=http://127.0.0.1:8000

# Secret material used by the application. Replace with a long random value.
SECRET_KEY=change-this-to-a-long-random-secret-at-least-32-chars
SUPERADMIN_SECRET=change-this-virtual-superadmin-token

# Open-source builds use the built-in first administrator during setup.
# Record the actual credentials used for this internal deployment here.
ADMIN_EMAIL=admin@windmill.dev
ADMIN_PASSWORD=changeme

# Runtime image. Build this locally from custom/product-main with CE features.
WINDMILL_IMAGE=internal-windmill:ce-source

# Runtime tuning.
NUM_WORKERS=2
FAVOR_UNSHARE_PID=true
CREATE_WORKSPACE_REQUIRE_SUPERADMIN=false
RUST_LOG=info
